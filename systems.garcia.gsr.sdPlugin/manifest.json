{
  "Name": "GPU Screen Recorder",
  "Description": "Watch the replay buffer, recording and stream from a Stream Deck, and save the buffer with one key.",
  "Author": "NyleGarcia",
  "Version": "2.0.0",
  "Icon": "icons/plugin",
  "Category": "GPU Screen Recorder",
  "SDKVersion": 2,
  "CodePath": "run.sh",
  "CodePathLin": "run.sh",
  "Software": {
    "MinimumVersion": "6.0"
  },
  "OS": [
    {
      "Platform": "linux",
      "MinimumVersion": "0"
    }
  ],
  "Actions": [
    {
      "Name": "Replay",
      "UUID": "systems.garcia.gsr.replay",
      "Icon": "icons/replay",
      "Tooltip": "Whether the replay buffer is running, how long it is and how full. Press to start or stop it.",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "pi/replay.html",
      "States": [
        {
          "Image": "icons/replay",
          "Title": ""
        }
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "StackColor": "#3ecf8e",
        "TriggerDescription": {
          "Rotate": "Browse recent saves",
          "Push": "Start or stop replay",
          "Touch": "Show / open a save"
        }
      }
    },
    {
      "Name": "Save Replay",
      "UUID": "systems.garcia.gsr.save",
      "Icon": "icons/save",
      "Tooltip": "Save the replay buffer, whole or the last few minutes, and show the file it wrote.",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "pi/save.html",
      "States": [
        {
          "Image": "icons/save",
          "Title": ""
        }
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "StackColor": "#3ba7f0",
        "TriggerDescription": {
          "Rotate": "Choose how much to save",
          "Push": "Save",
          "Touch": "Save"
        }
      }
    },
    {
      "Name": "Save Section",
      "UUID": "systems.garcia.gsr.section",
      "Icon": "icons/section",
      "Tooltip": "Press to mark a start, press again to save the replay from the mark to now. On a dial, turn to move the mark.",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/section.html",
      "States": [
        {
          "Image": "icons/section",
          "Title": ""
        }
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "StackColor": "#e5484d",
        "TriggerDescription": {
          "Rotate": "Move the mark",
          "Push": "Mark, then save",
          "Touch": "Cancel the mark"
        }
      }
    },
    {
      "Name": "Record",
      "UUID": "systems.garcia.gsr.record",
      "Icon": "icons/record",
      "Tooltip": "Start and stop a recording, including one running inside the replay buffer. Shows elapsed time and file size.",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "pi/record.html",
      "States": [
        {
          "Image": "icons/record",
          "Title": ""
        }
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "StackColor": "#e5484d",
        "TriggerDescription": {
          "Rotate": "Left pause, right resume",
          "Push": "Start or stop recording",
          "Touch": "Start or stop recording"
        }
      }
    },
    {
      "Name": "Stream",
      "UUID": "systems.garcia.gsr.stream",
      "Icon": "icons/stream",
      "Tooltip": "Start and stop streaming, with the service and how long it has been live.",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "pi/stream.html",
      "States": [
        {
          "Image": "icons/stream",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Screenshot",
      "UUID": "systems.garcia.gsr.screenshot",
      "Icon": "icons/screenshot",
      "Tooltip": "Take a screenshot of the screen, a region or a window, and show the file it wrote.",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "pi/screenshot.html",
      "States": [
        {
          "Image": "icons/screenshot",
          "Title": ""
        }
      ]
    },
    {
      "Name": "Status",
      "UUID": "systems.garcia.gsr.status",
      "Icon": "icons/status",
      "Tooltip": "A read-only readout: what is capturing, from which monitor, at what frame rate, codec and bitrate.",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/status.html",
      "States": [
        {
          "Image": "icons/status",
          "Title": ""
        }
      ]
    }
  ]
}
